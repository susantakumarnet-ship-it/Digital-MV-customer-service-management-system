# ---------------------------------------------------------------------------------------------------
# Digital MV CSMS — API environment. Copy to apps/api/.env and fill in. NEVER commit .env files.
# ---------------------------------------------------------------------------------------------------
NODE_ENV=development
PORT=4610
LOG_LEVEL=info

# MongoDB — must be a replica set (transactions). Atlas clusters qualify.
# Atlas: copy the "Drivers" connection string from Atlas → Connect, e.g.
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local replica set:
#   MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_URI=
MONGODB_DB=MVServiceMgmt

# Security — generate fresh values per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   (JWT secret)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"      (MFA key)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Digital MV CSMS

# Web app
WEB_ORIGINS=http://localhost:5610
PUBLIC_APP_URL=http://localhost:5610
COOKIE_SECURE=false
TRUST_PROXY=0

# Email: file (writes .eml to MAIL_DIR) | smtp | none
MAIL_TRANSPORT=file
MAIL_FROM=Digital MV CSMS <no-reply@localhost>
MAIL_DIR=var/mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Seed (first administrator; demo users only outside production)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# Expose /api/v1/docs in production (default: dev/staging only)
API_DOCS_ENABLED=false

# Sign-in attempts per IP per 15 minutes (keep 20 in production)
LOGIN_RATE_LIMIT_PER_15_MIN=20
